{
  "name": "tidyr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.6.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --filter=./apps/* --filter=./packages/* run build",
    "typecheck": "pnpm -r --filter=./apps/* --filter=./packages/* run typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "pnpm -r --filter=./apps/* --filter=./packages/* run test",
    "security:secrets": "bash scripts/scan-secrets.sh",
    "contracts:build": "cd packages/contracts && forge build",
    "contracts:test": "cd packages/contracts && forge test"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "@eslint/js": "9.17.0",
    "typescript-eslint": "8.19.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2"
  }
}
