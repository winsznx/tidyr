node_modules/

# Env files - allow-list only; never let a real secret slip in by pattern miss
.env*
!.env.example
!.env.*.example

dist/
build/
.next/
out/
cache/
cache_forge/
broadcast/
coverage/
*.log
.DS_Store
.turbo/
artifacts/security/*.tmp
lcov.info
internal/
*.tsbuildinfo

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Deployment tooling
.vercel/
.railway/

# Non-canonical lockfiles - this repo standardizes on pnpm (pnpm-lock.yaml)
package-lock.json
yarn.lock
.pnpm-debug.log*

# Key material - defense in depth, in addition to the .env* rule above
*.pem
*.key
